{
  "name": "track-body",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve --host 0.0.0.0 --ssl",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "jest",
    "start:mobile": "ng serve --host 0.0.0.0 --ssl",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "docs": "jest --coverage --silent && compodoc -c .compodocrc.json --language es-ES && node scripts/docs-mermaid.js docs",
    "docs:serve": "npm run docs && compodoc -s -d docs -o",
    "test:types": "tsc -p tsconfig.spec.json --noEmit"
  },
  "private": true,
  "dependencies": {
    "@angular/common": "^19.2.0",
    "@angular/compiler": "^19.2.0",
    "@angular/core": "^19.2.0",
    "@angular/forms": "^19.2.0",
    "@angular/platform-browser": "^19.2.0",
    "@angular/platform-browser-dynamic": "^19.2.0",
    "@angular/router": "^19.2.0",
    "@mediapipe/tasks-vision": "^1.2.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^19.2.22",
    "@angular/cli": "^19.2.22",
    "@angular/compiler-cli": "^19.2.0",
    "@compodoc/compodoc": "^2.0.0",
    "@types/jest": "^29.5.14",
    "fake-indexeddb": "^6.2.6",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "jest-preset-angular": "^14.6.2",
    "mermaid": "^11.17.2",
    "typescript": "~5.7.2"
  }
}
